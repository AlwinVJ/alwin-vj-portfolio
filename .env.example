# Portfolio Environment Variables

# Contact Email Address (Displayed as fallback when sending emails)
VITE_CONTACT_EMAIL=alwinvj5@gmail.com

# Optional EmailJS Service Integration
# (If omitted, the contact form falls back gracefully to opening the user's default email client)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional Base Path Override
# Default in production is '/portfolio/' (matching GitHub Pages project repository).
# Set to '/' if deploying to a custom domain (e.g. alwin.dev) or a user site (alwinvj.github.io).
# VITE_BASE_PATH=/portfolio/
